# Copy to .env and fill in. Never commit .env.
# On the server it lives in /opt/dashboard/.env (root:dashboard, mode 640).

# --- Links on the home grid. Empty = the Caddy name http://<name>.home.arpa
#     (Folders has no default and is hidden when empty)
MEDIA_LINK=
TORRENT_LINK=
NAS_LINK=
CAMERA_LINK=
TORRENT_FOLDERS_LINK=
BOOKS_LINK=
JELLYSEERR_LINK=
IMMICH_LINK=
RADARR_LINK=
SONARR_LINK=
PROWLARR_LINK=
PIHOLE_LINK=
PROXMOX_LINK=

# --- Proxmox (read-only API token, role PVEAuditor)
PROXMOX_HOST=
PROXMOX_USER=
PROXMOX_TOKEN=
# Optional: token id (default "dashboard") and node (default: the first node)
PROXMOX_TOKEN_NAME=
PROXMOX_NODE=

# --- qBittorrent Web API
QBITTORRENT_NAME=
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

# --- Media stack. *_URL is optional (defaults to the container's direct address).
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYSEERR_URL=
JELLYSEERR_API_KEY=
IMMICH_URL=
IMMICH_API_KEY=

# --- Pi-hole v6 (Settings -> Web interface/API -> app password)
PIHOLE_URL=
PIHOLE_APP_PASSWORD=

# --- Books page (Gmail app password)
GMAIL_ADDRES=
GMAIL_APP_PASSWORD=
